	measure 'Snapshot View Decision Score' = VAR _Seq = SELECTEDVALUE(SnapshotMetadataTable[snapshot_sequence], 2) RETURN CALCULATE(MAX(GoldSnapshotsTable[decision_score]), REMOVEFILTERS(SnapshotMetadataTable), TREATAS({_Seq}, SnapshotMetadataTable[snapshot_sequence]))
		formatString: 0.0000
