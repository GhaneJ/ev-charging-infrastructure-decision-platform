	measure 'Focus EV Volume Score' = VAR _Muni = [Focus Municipality] RETURN CALCULATE([Current EV Volume Score], REMOVEFILTERS(DimMunicipality), TREATAS({_Muni}, DimMunicipality[municipality]))
		formatString: 0.0000
		lineageTag: e6e7644c-a5a9-48f9-ae53-b8e13f9ec384

