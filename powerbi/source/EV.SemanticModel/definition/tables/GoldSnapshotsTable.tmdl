	measure 'Snapshot View Rank' = VAR _Seq = SELECTEDVALUE(SnapshotMetadataTable[snapshot_sequence], 2) RETURN CALCULATE(MIN(GoldSnapshotsTable[rank]), REMOVEFILTERS(SnapshotMetadataTable), TREATAS({_Seq}, SnapshotMetadataTable[snapshot_sequence]))
		formatString: 0
