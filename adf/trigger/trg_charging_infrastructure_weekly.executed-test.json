      "recurrence": {
        "frequency": "Week",
        "interval": 1,
        "startTime": "2026-10-02T16:40:00",
        "endTime": "2026-10-03T23:59:00",
        "timeZone": "W. Europe Standard Time",
        "schedule": {
          "minutes": [
            45
          ],
          "hours": [
