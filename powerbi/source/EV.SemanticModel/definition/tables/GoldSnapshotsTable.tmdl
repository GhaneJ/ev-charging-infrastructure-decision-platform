	measure 'Biggest Riser' =
			
			VAR _Top =
			    TOPN(
			        1,
			        FILTER(VALUES(DimMunicipality[municipality]), NOT ISBLANK([Rank Change])),
			        [Rank Change], DESC,
			        DimMunicipality[municipality], ASC
			    )
			RETURN
			    CONCATENATEX(_Top, DimMunicipality[municipality] & "  +" & FORMAT([Rank Change], "0"), "")
		lineageTag: 554ba071-8f1e-41fa-8fb8-34ee77ba3e19

	measure 'Biggest Faller' =
			
			VAR _Bottom =
			    TOPN(
			        1,
			        FILTER(VALUES(DimMunicipality[municipality]), NOT ISBLANK([Rank Change])),
			        [Rank Change], ASC,
			        DimMunicipality[municipality], ASC
			    )
			RETURN
			    CONCATENATEX(_Bottom, DimMunicipality[municipality] & "  " & FORMAT([Rank Change], "0"), "")
		lineageTag: ff080299-83bc-4692-98ce-1b7d03d4d20e

