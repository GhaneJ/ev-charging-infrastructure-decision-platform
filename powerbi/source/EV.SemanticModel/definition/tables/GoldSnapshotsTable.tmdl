	measure 'Snapshot View Show In Top N' = IF(NOT ISBLANK([Snapshot View Rank]) && [Snapshot View Rank] <= [Selected Top N], 1, 0)
		formatString: 0
		lineageTag: 12345678-1234-4a9b-8abc-123456789105

	measure 'Snapshot View Decision Score Top N' = IF([Snapshot View Show In Top N] = 1, [Snapshot View Decision Score], BLANK())
		formatString: 0.0000
		lineageTag: 12345678-1234-4a9b-8abc-123456789106

	measure 'Snapshot View Top Candidate' = VAR _Top = TOPN(1, FILTER(VALUES(DimMunicipality[municipality]), [Snapshot View Show In Top N] = 1), [Snapshot View Rank], ASC, DimMunicipality[municipality], ASC) RETURN CONCATENATEX(_Top, DimMunicipality[municipality], "")
		lineageTag: 12345678-1234-4a9b-8abc-123456789107

	measure 'Snapshot View Top Candidate Score' = VAR _Top = TOPN(1, FILTER(VALUES(DimMunicipality[municipality]), [Snapshot View Show In Top N] = 1), [Snapshot View Rank], ASC, DimMunicipality[municipality], ASC) RETURN MAXX(_Top, [Snapshot View Decision Score])
		formatString: 0.0000
		lineageTag: 12345678-1234-4a9b-8abc-123456789108

	measure 'Snapshot View Visible Candidates' = COUNTROWS(FILTER(VALUES(DimMunicipality[municipality]), [Snapshot View Show In Top N] = 1))
		formatString: 0
