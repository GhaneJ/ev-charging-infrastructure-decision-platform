	partition DimMunicipality = calculated
		mode: import
		source =
				
				DISTINCT(
				    SELECTCOLUMNS(
				        SnapshotComparisonTable,
				        "municipality", SnapshotComparisonTable[municipality],
				        "country", SnapshotComparisonTable[country],
				        "map_location", SnapshotComparisonTable[map_location],
				        "price_area", SnapshotComparisonTable[price_area],
				        "membership_status", SnapshotComparisonTable[membership_status],
				        "current_rank", SnapshotComparisonTable[current_rank],
				        "previous_rank", SnapshotComparisonTable[previous_rank],
				        "rank_change", SnapshotComparisonTable[rank_change],
				        "rank_direction", SnapshotComparisonTable[rank_direction],
				        "current_ev_registrations_12m", SnapshotComparisonTable[current_ev_registrations_12m],
				        "current_ev_registration_change_6m", SnapshotComparisonTable[current_ev_registration_change_6m],
				        "current_avg_sek_per_kwh", SnapshotComparisonTable[current_avg_sek_per_kwh],
				        "current_decision_score", SnapshotComparisonTable[current_decision_score]
				    )
				)

