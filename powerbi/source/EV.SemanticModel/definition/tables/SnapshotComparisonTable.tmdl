table SnapshotComparisonTable
	lineageTag: 1eba7311-0e3f-4412-8500-f7d7f9aabd56

	measure 'Previous Rank' =
			
			MIN(SnapshotComparisonTable[previous_rank])
		formatString: 0
		lineageTag: 798afdba-5742-4dfc-8470-cf2264f1f90b

	measure 'Rank Change' =
			
			VAR _PreviousRank = [Previous Rank]
			VAR _CurrentRank = [Current Rank]
			RETURN
			    IF(
			        ISBLANK(_PreviousRank) || ISBLANK(_CurrentRank),
			        BLANK(),
			        _PreviousRank - _CurrentRank
			    )
		formatString: 0
		lineageTag: b5a55593-f78c-469f-92ce-880f892e5cb0

	measure 'Previous Decision Score' =
			
			MAX(SnapshotComparisonTable[previous_decision_score])
		lineageTag: 0a0b1bf3-799a-49f9-a693-f8abf656a7f3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Decision Score Change' =
			
			MAX(SnapshotComparisonTable[decision_score_change])
		lineageTag: f5cc112e-44cd-4ff0-970a-efbe9358e079

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Growth Change' =
			
			MAX(SnapshotComparisonTable[growth_change])
		formatString: 0
		lineageTag: bd0c84ba-4141-4e00-af16-b21217e22622

	measure 'Electricity Price Change' =
			
			MAX(SnapshotComparisonTable[electricity_price_change])
		lineageTag: a88f814b-1d07-4da3-94df-c139662f2dc9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'EV Registrations Change' =
			
			MAX(SnapshotComparisonTable[ev_registrations_12m_change])
		formatString: 0
		lineageTag: 8ce63345-041e-422b-b1cf-021265fd00cc

